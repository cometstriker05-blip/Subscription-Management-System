# Everything here is optional for local work. Keel runs fully without any of it.

# Gemini, for reading PDF and photo statements and for Ask Keel. Without it, Keel uses its rules.
# A Gemini API key or a Vertex AI key both work here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Or use Vertex AI instead of an API key, which spends your Google Cloud credit.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=global

# Real email. Without it, messages land in the Outbox page. Example for Gmail with an app password:
# SMTP_URL=smtps://you%40gmail.com:app-password@smtp.gmail.com:465
# MAIL_FROM=Brightloop Billing <you@gmail.com>

# Where reset links point.
# APP_URL=https://your-keel-url.run.app
